Resonance.CompactGramGap.projected_square_gap.{u_1, u_2} {H : Type u_1} {J : Type u_2} [NormedAddCommGroup.{u_1} H]
  [InnerProductSpace.{0, u_1} Real H] [CompleteSpace.{u_1} H] [NormedAddCommGroup.{u_2} J]
  [InnerProductSpace.{0, u_2} Real J] [CompleteSpace.{u_2} J]
