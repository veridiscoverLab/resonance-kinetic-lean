    (And (Eq.{1} (Resonance.ActualSobolevDifferentiation.trajectory hR hθ hc s v 0) v)
      (And
        (∀ (t : Real),
          LE.le.{0} 0 t →
            Resonance.ActualSobolevReality.IsReal hR hθ s
              (Resonance.ActualSobolevDifferentiation.trajectory hR hθ hc s v t))
        (∀ (t : Real),
          LE.le.{0} 0 t →
            And
              (HasDerivWithinAt.{0, 0}
                (fun r =>
                  (Resonance.ActualSobolevInclusion.inclusion s)
                    (Resonance.ActualSobolevDifferentiation.trajectory hR hθ hc s v r))
                ((Resonance.ActualSobolevDifferentiation.differential hR hθ hc s)
                  (Resonance.ActualSobolevDifferentiation.trajectory hR hθ hc s v t))
                (Set.Ici.{0} 0) t)
              (Eq.{1}
                (HAdd.hAdd.{0, 0, 0}
                  ((Resonance.ActualSobolevMatrixAction.action hR hθ (HSub.hSub.{0, 0, 0} s 2)
                      (Resonance.Thermodynamics.gramMatrix R θ))
                    ((Resonance.ActualSobolevDifferentiation.differential hR hθ hc s)
                      (Resonance.ActualSobolevDifferentiation.trajectory hR hθ hc s v t)))
                  (∑ j,
                    (Resonance.ActualSobolevMatrixAction.action hR hθ (HSub.hSub.{0, 0, 0} s 2)
                        (Resonance.EulerCoefficients.fluxMatrix R j θ))
                      ((Resonance.ActualSpatialDifferentials.first s j)
                        (Resonance.ActualSobolevDifferentiation.trajectory hR hθ hc s v t))))
                (HSMul.hSMul.{0, 0, 0} (Inv.inv.{0} ↑c)
                  (∑ i,
                    ∑ j,
                      (Resonance.ActualSobolevMatrixAction.action hR hθ (HSub.hSub.{0, 0, 0} s 2)
                          (Resonance.ActualSpatialMatrixSymbols.block hR hθ i j))
                        ((Resonance.ActualSpatialDifferentials.second s i j)
                          (Resonance.ActualSobolevDifferentiation.trajectory hR hθ hc s v t))))))))
Resonance.ActualRealSobolevPDE.original_real_complete_decay {R : Real} (hR : LT.lt.{0} 0 R)
  {K : Set.{0} Resonance.Thermodynamics.Parameter} (hK : IsCompact.{0} K)
  (hpos : HasSubset.Subset.{0} K (Resonance.Thermodynamics.positiveDomain R)) :
  ∃ a,
    And (LT.lt.{0} 0 a)
      (∀ (θ : ↑K) (c : Real) (hc : LE.le.{0} 1 c) (s : Real) (v : ↥(Resonance.ActualSobolevSpace.Sobolev s)),
        Resonance.ActualSobolevReality.IsReal hR ⋯ s v →
