Resonance.ActualFourierWellPosed.original_integer_mode_decay {R : Real} (hR : LT.lt.{0} 0 R)
  {K : Set.{0} Resonance.Thermodynamics.Parameter} (hK : IsCompact.{0} K)
  (hpos : HasSubset.Subset.{0} K (Resonance.Thermodynamics.positiveDomain R)) :
  ∃ δ,
    And (LT.lt.{0} 0 δ)
      (∀ (θ : ↑K) (c : Real),
        LT.lt.{0} 0 c →
          ∀ (n : Resonance.PhysicalScalarFourier.Frequency) (T : Real),
            LE.le.{0} 0 T →
              ∀ (u du : Real → Resonance.MatrixHilbertDictionary.H),
                (∀ (t : Real),
                    Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t → HasDerivWithinAt.{0, 0} u (du t) (Set.Icc.{0} 0 T) t) →
                  (∀ (t : Real),
                      Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                        Eq.{1}
                          (HAdd.hAdd.{0, 0, 0}
                            (HAdd.hAdd.{0, 0, 0}
                              ((Resonance.MatrixHilbertDictionary.operator (Resonance.Thermodynamics.gramMatrix R ↑θ))
                                (du t))
                              (HSMul.hSMul.{0, 0, 0} Complex.I
                                ((Resonance.MatrixHilbertDictionary.operator
                                    (Resonance.ActualEulerCoupling.spatialMatrix R ↑θ fun j => ↑(n j)))
                                  (u t))))
                            (HSMul.hSMul.{0, 0, 0} (Inv.inv.{0} ↑c)
                              ((Resonance.MatrixHilbertDictionary.operator
                                  (Resonance.ActualFourierSymbol.symbol hR ⋯ fun j => ↑(n j)))
                                (u t))))
                          0) →
                    LE.le.{0} (Resonance.ActualOriginalModeDecay.gramEnergy R (↑θ) (u T))
                      (HMul.hMul.{0, 0, 0}
                        (HMul.hMul.{0, 0, 0} 3
                          (Real.exp
                            (HMul.hMul.{0, 0, 0}
                              (HMul.hMul.{0, 0, 0} (Neg.neg.{0} δ)
                                (Resonance.FourierCompensationWeights.rate c
                                  (Resonance.PhysicalFourierFrequencies.radius n)))
                              T)))
                        (Resonance.ActualOriginalModeDecay.gramEnergy R (↑θ) (u 0))))
