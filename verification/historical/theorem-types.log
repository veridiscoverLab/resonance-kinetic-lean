  ∃ T,
    And (LT.lt.{0} 0 T)
      (∃ p,
        And (Continuous.{0, 0} p)
          (And (Eq.{1} (p 0) p₀)
            (And
              (∀ (t : Real),
                Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                  ∀ (z : Resonance.FreeTransport.Phase R),
                    LE.le.{0} (HDiv.hDiv.{0, 0, 0} m 2) ((Resonance.JetCollision.readback (p t)) z))
              (And
                (∀ (t : Real),
                  ContDiff.{0, 0, 0} Real 3
                    (Resonance.SpatialChainRule.realLift (Resonance.JetCollision.readback (p t))))
                (∀ (t : Real),
                  Membership.mem.{0, 0} (Set.Icc.{0} 0 T) t →
                    Eq.{1} (Resonance.JetCollision.readback (p t))
                      (HAdd.hAdd.{0, 0, 0} (Resonance.FreeTransport.transport R t (Resonance.JetCollision.readback p₀))
                        (∫ (s : Real) in 0..t,
                          HSMul.hSMul.{0, 0, 0} c
                            (Resonance.FreeTransport.transport R (HSub.hSub.{0, 0, 0} t s)
                              (Resonance.SpatialCollision.collision R hR
                                (Resonance.JetCollision.readback (p s)))))))))))
