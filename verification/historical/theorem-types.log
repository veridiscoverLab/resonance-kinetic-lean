                    (HMul.hMul.{0, 0, 0}
                      (HMul.hMul.{0, 0, 0} (Real.sqrt 3)
                        (Real.exp (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} (Neg.neg.{0} a) t) c)))
