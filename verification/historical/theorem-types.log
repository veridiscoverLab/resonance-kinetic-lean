          (Set.Icc.{0} 0 ↑T) t)
  (heq :
    ∀ (n : Resonance.PhysicalScalarFourier.Frequency) (t : Real),
      Membership.mem.{0, 0} (Set.Icc.{0} 0 ↑T) t →
        Eq.{1}
          (HAdd.hAdd.{0, 0, 0}
            (HAdd.hAdd.{0, 0, 0}
              ((Resonance.MatrixHilbertDictionary.operator (Resonance.Thermodynamics.gramMatrix R θ)) (du n t))
              (HSMul.hSMul.{0, 0, 0} Complex.I
                ((Resonance.MatrixHilbertDictionary.operator
                    (Resonance.ActualEulerCoupling.spatialMatrix R θ fun j => ↑(n j)))
                  (Resonance.ActualSobolevSpace.coefficient hR hθ s (u t) n))))
            (HSMul.hSMul.{0, 0, 0} (Inv.inv.{0} ↑c)
              ((Resonance.MatrixHilbertDictionary.operator (Resonance.ActualFourierSymbol.symbol hR hθ fun j => ↑(n j)))
                (Resonance.ActualSobolevSpace.coefficient hR hθ s (u t) n))))
          0) :
  Eq.{1} (u ↑T) ((Resonance.ActualSobolevSemigroup.evolution hR hθ hc s T) (u 0))
