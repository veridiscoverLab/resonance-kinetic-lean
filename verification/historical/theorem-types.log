                    (∫ (k : Resonance.ResonantMeasure.E), HMul.hMul.{0, 0, 0} (↑↑v k) (↑↑F k) ∂
                      Resonance.ActualPairNormalization.cubeVolume R))
                (And
                  (MeasureTheory.MemLp.{0, 0}
                    (fun k => HMul.hMul.{0, 0, 0} (Resonance.CollisionFrequency.referenceFrequency R k) (↑↑u k))
                    Top.top.{0} (Resonance.ActualPairNormalization.cubeVolume R))
                  (And
                    (∀ᵐ (k : Resonance.PlaneCoarea.E) ∂ Resonance.ActualPairNormalization.cubeVolume R,
                      LE.le.{0}
                        (Norm.norm.{0}
                          (HMul.hMul.{0, 0, 0} (Resonance.CollisionFrequency.referenceFrequency R k) (↑↑u k)))
                        (HMul.hMul.{0, 0, 0} C (Norm.norm.{0} F)))
                    (∀ (w : ↥(Resonance.ReferenceFrequencySpace.Space R)),
                      Eq.{1} ((Resonance.PhysicalMomentProjection.projection hR hθ) w) 0 →
                        (∀ (v : ↥(Resonance.ReferenceFrequencySpace.Space R)),
                            Eq.{1} (Resonance.PhysicalWeightedCoercivity.physicalForm ⋯ hθ w v)
                              (∫ (k : Resonance.ResonantMeasure.E), HMul.hMul.{0, 0, 0} (↑↑v k) (↑↑F k) ∂
                                Resonance.ActualPairNormalization.cubeVolume R)) →
